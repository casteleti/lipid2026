generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      UserRole  @default(USER)
  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

model Application {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  excerpt     String?
  icon        String?
  banner      String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  technologies TechnologyOnApplication[]
  ingredients  IngredientOnApplication[]

  @@index([slug])
  @@map("applications")
}

model Technology {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  excerpt     String?
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)

  // ------------------------------------------------------------------ LANDING PAGE
  // A rota /tecnologias/<slug> é a landing da tecnologia (mesmo papel das páginas de
  // segmento). Os campos abaixo compõem as 3 dobras: hero, essência e formulário.
  // `description`/`excerpt` continuam servindo listagens e páginas relacionadas.
  eyebrow      String?
  h1           String? @db.Text
  subheadline  String? @db.Text
  heroCtaLabel String?

  /// Duas ilustrações da página. Caminho começando com "/" = asset estático do site;
  /// caminho de upload = servido pela API (resolveMediaUrl trata os dois casos).
  imageOneUrl     String?
  imageOneAlt     String?
  imageOneCaption String?
  imageTwoUrl     String?
  imageTwoAlt     String?
  imageTwoCaption String?

  essenceTitle  String?
  essenceIntro  String? @db.Text
  /// {title, description}[] — pilares da dobra 2.
  pillars       Json?
  criteriaTitle String?
  /// {label, description}[] — o que a Lipid coloca na mesa nessa tecnologia.
  criteria      Json?
  /// Frase de autoridade, exibida isolada entre as dobras.
  authorityStatement String? @db.Text

  formEyebrow          String?
  formTitle            String? @db.Text
  formDescription      String? @db.Text
  formValueProposition String? @db.Text
  formCtaLabel         String?
  formSuccessMessage   String? @db.Text
  /// Opções do "principal desafio técnico" desta tecnologia — string[].
  formChallengeOptions Json?

  seoTitle       String?
  seoDescription String? @db.Text
  seoKeywords    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications TechnologyOnApplication[]
  ingredients  IngredientOnTechnology[]

  @@index([slug])
  @@map("technologies")
}

model TechnologyOnApplication {
  technology    Technology  @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId  String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String

  @@id([technologyId, applicationId])
  @@map("technologies_on_applications")
}

/// Categoria técnica do ingrediente (ex.: "Lecitinas e fosfolipídios de soja", "Antioxidantes").
/// Taxonomia GLOBAL, compartilhada entre fabricantes — "Ativos hidratantes" é usada tanto pela
/// Lipoid quanto pela Readline. Não criar categorias por fabricante.
model IngredientCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients Ingredient[]

  @@index([slug])
  @@map("ingredient_categories")
}

/// Marcador transversal de busca/filtro. Diferente de categoria: um ingrediente tem UMA categoria
/// e VÁRIAS tags. Normalizada (e não text[]) para permitir filtro facetado por slug e renomear
/// uma tag sem reescrever todas as linhas de ingrediente.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients IngredientOnTag[]

  @@index([slug])
  @@map("tags")
}

model IngredientOnTag {
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId        String

  @@id([ingredientId, tagId])
  @@map("ingredients_on_tags")
}

/// Código comercial do ingrediente na Lista de Produtos LIPID. Um produto pode ter VÁRIOS
/// (ex.: ReGrow-Ex = 873645.10 / 873645.100 / 873645.1000), tipicamente variações de
/// apresentação. SEMPRE String, nunca numérico: há códigos com zero à esquerda
/// ("040723.100000") e pares como ".100"/".1000" que um NUMERIC colapsaria no mesmo valor.
/// Imagens do ingrediente (produto, aplicação, gráficos). Opcional: a ficha funciona sem
/// nenhuma. 1:N para permitir galeria.
model IngredientImage {
  id           String     @id @default(cuid())
  url          String
  alt          String?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([ingredientId])
  @@map("ingredient_images")
}

/// Documentos anexos (ficha técnica, especificação, certificado). `label` é o que aparece
/// para o visitante — o nome do arquivo no disco é aleatório (uuid) por causa do upload.
model IngredientFile {
  id           String     @id @default(cuid())
  url          String
  label        String
  sizeBytes    Int?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([ingredientId])
  @@map("ingredient_files")
}

model IngredientCode {
  id           String     @id @default(cuid())
  code         String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([ingredientId])
  @@map("ingredient_codes")
}

model Ingredient {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String              @db.Text
  excerpt     String?
  /// Frase de encerramento própria do produto, vinda do PDF ("Apresente sua formulação no
  /// Formulário de Atendimento..."). Varia por ingrediente — não é boilerplate.
  cta         String?             @db.Text
  inci        String?
  partnerId   String?
  partner     Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    IngredientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active      Boolean             @default(true)
  /// Visitas na ficha pública. Contador simples (sem tabela de eventos): o painel só
  /// precisa do ranking de mais acessados, não da série temporal.
  views       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  codes        IngredientCode[]
  images       IngredientImage[]
  files        IngredientFile[]
  tags         IngredientOnTag[]
  leads        Lead[]
  technologies IngredientOnTechnology[]
  applications IngredientOnApplication[]

  /// Nome é único POR FABRICANTE, não globalmente: duas fabricantes podem vender a mesma
  /// molécula commodity (ex.: "Glutathione", "Ergothioneine"). O slug segue global por ser URL.
  @@unique([partnerId, name])
  @@index([slug])
  @@index([partnerId])
  @@index([categoryId])
  @@map("ingredients")
}

model IngredientOnTechnology {
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId String

  @@id([ingredientId, technologyId])
  @@map("ingredients_on_technologies")
}

model IngredientOnApplication {
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId  String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String

  @@id([ingredientId, applicationId])
  @@map("ingredients_on_applications")
}

/// Fabricante internacional representado pela Lipid no Brasil (ex.: Lipoid, Readline).
/// Partner é sempre o fabricante — nunca a própria Lipid. Não confundir/misturar as identidades
/// na hora de exibir este conteúdo no site.
model Partner {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  excerpt     String?
  logo        String?
  image       String?
  websites    String[] @default([])
  country     String?
  highlights  String?  @db.Text
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients Ingredient[]

  @@index([slug])
  @@map("partners")
}

/// Conteúdo singleton da página institucional (/sobre). Existe sempre exatamente uma linha,
/// identificada pelo id fixo "singleton".
model InstitutionalPage {
  id String @id @default("singleton")

  // 1. Hero institucional
  heroEyebrow           String?
  heroTitle             String?
  heroDescription       String?  @db.Text
  heroImage             String?
  heroCtaPrimaryLabel   String?
  heroCtaPrimaryHref    String?
  heroCtaSecondaryLabel String?
  heroCtaSecondaryHref  String?

  // 2. Quem é a Lipid (fatos objetivos ficam em InstitutionalBlock/FACT)
  quemSomosIntro String? @db.Text

  // 3. Como a Lipid ajuda a indústria (passos ficam em InstitutionalBlock/PROCESS_STEP)
  comoAjudamosCta String? @db.Text

  // 6. Modelo de parceria (diagrama Cliente/Lipid/Fabricantes é fixo no front, só o texto é editável)
  parceriaText String? @db.Text

  // 8. Qualidade, procedência e confiança (bullets ficam em InstitutionalBlock/QUALITY_ITEM)
  qualidadeText String? @db.Text

  // 10. História e propósito (princípios ficam em InstitutionalBlock/PRINCIPLE)
  historiaText String? @db.Text

  // 12. CTA final
  ctaFinalHeading        String?
  ctaFinalText           String? @db.Text
  ctaFinalPrimaryLabel   String?
  ctaFinalPrimaryHref    String?
  ctaFinalSecondaryLabel String?
  ctaFinalSecondaryHref  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institutional_page")
}

/// Blocos repetíveis e ordenados que pertencem à página institucional (nunca listados/roteados
/// de forma independente). O significado de `title`/`description` varia por `section`:
/// FACT: title=rótulo curto · PROCESS_STEP: title+description · QUALITY_ITEM: title=bullet
/// METRIC: value+title (ex. value="2006", title="Desde") · PRINCIPLE: title+description
/// FAQ: title=pergunta, description=resposta
enum InstitutionalBlockSection {
  FACT
  PROCESS_STEP
  QUALITY_ITEM
  METRIC
  PRINCIPLE
  FAQ
}

model InstitutionalBlock {
  id          String                    @id @default(cuid())
  section     InstitutionalBlockSection
  icon        String?
  title       String?
  value       String?
  description String?                   @db.Text
  order       Int                       @default(0)
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([section, order])
  @@map("institutional_blocks")
}

/// Layout novo da página institucional (/institucional) — blocos alternados esquerda/direita
/// com áreas de imagem. Substitui InstitutionalPage/InstitutionalBlock (mantidos no schema só
/// pra não perder o histórico; a página passou a renderizar por aqui). Um `InstitutionalSection`
/// por bloco da página (hero, quem-somos, como-atuamos...), na ordem em que aparecem — `slug`
/// é a âncora (#quem-somos) e `type` decide qual componente React renderiza o bloco no site.
/// Campos que só fazem sentido pra alguns `type` (ex. contato, disclaimer) ficam soltos em
/// `extra` (JSON) pra não empilhar dezena de coluna quase sempre vazia.
model InstitutionalSection {
  id        String   @id @default(cuid())
  slug      String   @unique
  type      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  eyebrow   String?
  title     String?  @db.Text
  subtitle  String?  @db.Text
  body      String?  @db.Text
  highlight String?  @db.Text
  quote     String?  @db.Text

  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?

  /// Descrição do tipo de imagem esperada nesse bloco (ex. "Foto da equipe no laboratório,
  /// horizontal") — aparece como legenda da área reservada enquanto `imageUrl` estiver vazio.
  imageHint String? @db.Text
  imageUrl  String?

  /// Dados específicos do tipo que não repetem em outros tipos (ex. disclaimer do grupo-lipoid,
  /// itens de contato). Formato livre por `type` — documentado nos componentes do front.
  extra Json?

  items InstitutionalSectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("institutional_sections")
}

/// Item repetível dentro de um InstitutionalSection (um fato, um passo, um pilar, uma empresa
/// do grupo, um item de contato...). O significado de cada campo varia por `section.type` — ver
/// os componentes React que consomem cada tipo pra saber quais campos usar.
model InstitutionalSectionItem {
  id        String               @id @default(cuid())
  section   InstitutionalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
  order     Int                  @default(0)
  active    Boolean              @default(true)

  icon     String?
  title    String?
  subtitle String?
  text     String? @db.Text
  value    String?

  linkLabel String?
  linkHref  String?

  imageHint String? @db.Text
  imageUrl  String?

  /// Campos extras que só existem pra alguns itens (ex. key_points[] das empresas do grupo,
  /// type/href dos itens de contato).
  extra Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, order])
  @@map("institutional_section_items")
}

/// Landing page por segmento de mercado (/segmentos/farmaceutica, /cosmetica, /nutricional,
/// /veterinaria). Conteúdo altamente paralelo entre os 4 (mesmo template, texto diferente) —
/// por isso uma tabela só com colunas fixas + JSON pros blocos repetíveis (parágrafos de
/// venda, aplicações), em vez do padrão seção+item usado na institucional.
model SegmentPage {
  id     String     @id @default(cuid())
  slug   String     @unique
  sector LeadSector @unique
  order  Int        @default(0)
  active Boolean    @default(true)

  eyebrow      String?
  h1           String? @db.Text
  subheadline  String? @db.Text
  /// Os 3 parágrafos comerciais — string[].
  salesParagraphs Json?

  applicationsTitle String?
  applicationsIntro String? @db.Text
  /// {title, description}[] — pelo menos 8 itens por página.
  applications      Json?

  floatingHighlight String? @db.Text

  ingredientExplorerHeadline       String?
  ingredientExplorerSupportingText String? @db.Text

  formEyebrow         String?
  formTitle           String? @db.Text
  formDescription     String? @db.Text
  formValueProposition String? @db.Text
  formCtaLabel        String?
  formSuccessMessage  String? @db.Text
  /// Opções do "principal desafio técnico" deste segmento — string[].
  formChallengeOptions Json?

  seoTitle       String?
  seoDescription String? @db.Text
  seoKeywords    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("segment_pages")
}

/// Contador leve de acesso por página de segmento — "quantas visitas cada tela recebeu".
/// Não é o event-tracking completo (sessão, UTM histórico, funil) do blueprint original;
/// é o necessário pra responder "acessos e leads gerados por tela" no painel.
model PageView {
  id        String   @id @default(cuid())
  route     String
  sector    LeadSector?
  referrer  String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  createdAt DateTime @default(now())

  @@index([route])
  @@index([sector])
  @@index([createdAt])
  @@map("page_views")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content ContentOnCategory[]

  @@index([slug])
  @@map("categories")
}

/// ARTIGO = texto aberto, lido na própria página.
/// DOWNLOAD = material (PDF/PPT/planilha) liberado só depois do formulário — é peça de
/// geração de lead, não de leitura. Os dois convivem na mesma listagem.
enum ContentType {
  ARTIGO
  DOWNLOAD
}

model Content {
  id      String        @id @default(cuid())
  type    ContentType   @default(ARTIGO)
  title   String        @unique
  slug    String        @unique
  excerpt String?
  /// HTML do artigo (vazio quando type=DOWNLOAD).
  content String        @db.Text
  /// Capa: vale como miniatura na listagem E como imagem de abertura na leitura.
  featured    String?
  featuredAlt String?
  status      ContentStatus @default(DRAFT)
  author      String?

  /// SEO: sobrescrevem title/excerpt nas meta tags quando preenchidos. Ficam separados
  /// porque o título que converte na tela raramente é o melhor título para busca.
  seoTitle       String?
  seoDescription String?

  /// Visitas na leitura pública — mesma ideia do contador de ingrediente.
  views Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  categories    ContentOnCategory[]
  summaryPoints ContentSummaryPoint[]
  faqs          ContentFaq[]
  files         ContentFile[]
  leads         Lead[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@map("content")
}

/// Resumo em tópicos ("o que você vai encontrar"). Serve leitura rápida e também dá ao
/// buscador/motor generativo um sumário explícito do conteúdo. Vazio = seção não aparece.
model ContentSummaryPoint {
  id        String   @id @default(cuid())
  text      String   @db.Text
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([contentId])
  @@map("content_summary_points")
}

/// Perguntas frequentes do tema. Viram FAQPage em JSON-LD — é o formato que buscadores e
/// motores de resposta citam diretamente. Vazio = seção não aparece.
model ContentFaq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([contentId])
  @@map("content_faqs")
}

/// Arquivo entregue no type=DOWNLOAD (PDF, PPT, planilha).
model ContentFile {
  id        String   @id @default(cuid())
  url       String
  label     String
  sizeBytes Int?
  mimetype  String?
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([contentId])
  @@map("content_files")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentOnCategory {
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([contentId, categoryId])
  @@map("content_on_categories")
}

enum LeadSector {
  FARMACEUTICA
  COSMETICO
  ALIMENTICIA
  NUTRICIONAL
  VETERINARIO
}

model Lead {
  id      String      @id @default(cuid())
  /// SEM @unique de propósito: cada envio é um registro. Antes era único, e o segundo
  /// formulário preenchido pelo mesmo e-mail (interesse em outro ingrediente) estourava
  /// P2002 e devolvia 500. Deduplicação de contato é trabalho do comercial, não do banco.
  email   String
  name    String?
  phone   String?
  company String?
  sector  LeadSector?
  message String?
  /// De onde veio: 'website' (contato geral) ou 'ingrediente' (formulário da ficha).
  source  String      @default("website")

  /// Página exata que converteu — todo formulário do site grava as duas. `pageTitle`
  /// existe porque URL sozinha é ilegível num relatório comercial
  /// (ex.: "Página do ingrediente β-Nicotinamide Mononucleotide").
  pageUrl   String?
  pageTitle String?

  /// Rota normalizada da landing que converteu (ex.: "/tecnologias/lipossomas").
  /// Existe além de `pageUrl` porque conversão por página se calcula cruzando com
  /// `page_views.route` — e `pageUrl` traz domínio, UTMs e âncora, o que quebra o join.
  landingRoute String?

  /// Qual ingrediente originou o interesse — lead de ficha de produto é lead qualificado.
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  /// Qual material o visitante baixou. Um lead vem de ingrediente OU de conteúdo, nunca
  /// dos dois — mas manter colunas separadas (em vez de um par polimórfico tipo+id) deixa
  /// a FK real e o relatório por material sai com um join simples.
  contentId String?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([ingredientId])
  @@index([contentId])
  @@index([landingRoute])
  @@map("leads")
}

model SeoPage {
  id          String   @id @default(cuid())
  route       String   @unique
  title       String?
  description String?
  keywords    String?
  ogImage     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seo_pages")
}
