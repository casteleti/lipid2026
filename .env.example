# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:password@postgres:5432/lipid_production

# ============================================
# BACKEND (NestJS API)
# ============================================
API_PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=dev-secret-change-in-production-please
JWT_EXPIRY=24h

# ============================================
# RD STATION MARKETING (integração de leads)
# ============================================
# API Key gerada em: RD Station > Configurações da conta > Integrações > API
# NUNCA commitar o valor real — apenas em .env.local
RD_STATION_API_KEY=

# ============================================
# SMTP — notificação interna do formulário /contato
# ============================================
# Configurar exclusivamente como segredo no Coolify. Nunca commitar credenciais reais.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFICATION_TO=

# ============================================
# FRONTEND (Next.js Website)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3002

# ============================================
# CMS ADMIN (Next.js)
# ============================================
# Usa a mesma API do frontend
# NEXT_PUBLIC_API_URL=http://localhost:3002

# ============================================
# OBSERVAÇÃO IMPORTANTE
# ============================================
# Copie este arquivo para .env.local e preencha valores reais
# NUNCA commit .env.local ou .env no Git
# Apenas .env.example é commitado
